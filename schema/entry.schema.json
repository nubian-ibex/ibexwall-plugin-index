{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibexwall.com/plugin-index/entry.schema.json",
  "title": "IbexWall plugin index entry",
  "description": "One file per plugin under index/, describing what it is and where it lives. The entry for an official plugin is generated from its manifest.",
  "type": "object",
  "required": ["id", "name", "description", "category", "kinds", "version", "origin", "license", "repository", "maintainers"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$", "description": "The plugin id, category.name, as the daemon knows it." },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 10 },
    "category": { "enum": ["system", "network", "apps", "endpoint", "vuln", "assistant", "other"] },
    "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["check", "control"] } },
    "version": { "type": "string" },
    "origin": { "enum": ["official", "community"] },
    "license": { "type": "string" },
    "repository": { "type": "string", "pattern": "^https://" },
    "maintainers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "signature": { "type": "string", "description": "The minisign public key the plugin's manifest is signed with, base64, when it is not the release key." }
  }
}
